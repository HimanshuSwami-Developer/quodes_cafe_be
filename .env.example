DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# Groq reads payment screenshots. Leave unset to send every proof to human review.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_VERIFY_ENABLED=true
# ---- Email: OTP codes + booking/ticket notifications ----
# Leave EMAIL_HOST empty to print emails in the server console (dev).
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, your Gmail address, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_REPLY_TO=
# Desk addresses that get "payment to verify" and "new ticket" alerts (comma-separated).
STAFF_ALERT_EMAILS=
# Public URL of this server (for admin links in staff emails)
SITE_URL=http://localhost:8000
REQUIRE_EMAIL_VERIFICATION=true
